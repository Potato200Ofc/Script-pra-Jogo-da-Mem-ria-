-- Busca precisa da carta exata na mesa do jogador
local function findExactCard(cardId)
	local cardsFolder = getPlayerCardsFolder()
	if not cardsFolder then return nil end

	local searchId = tostring(cardId)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	local candidateCards = {}
	for _, card in ipairs(cardsFolder:GetChildren()) do
		if card.Name == searchId or card.Name == "Card_" .. searchId then
			table.insert(candidateCards, card)
		end
	end

	if #candidateCards == 0 then
		return nil
	elseif #candidateCards == 1 then
		return candidateCards[1]
	else
		if not rootPart then return candidateCards[1] end
		local closestCard = nil
		local shortestDist = math.huge
		for _, card in ipairs(candidateCards) do
			local primaryPart = card:IsA("Model") and (card.PrimaryPart or card:FindFirstChildWhichIsA("BasePart")) or (card:IsA("BasePart") and card)
			if primaryPart then
				local dist = (primaryPart.Position - rootPart.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestCard = card
				end
			end
		end
		return closestCard or candidateCards[1]
	end
end

-- Cria o mini clone brilhante em Neon apontando e segurando a réplica da carta com suporte a R6 e R15
local function createPlayerPointingClone(cardInstance, targetColor)
	local char = player.Character
	if not char then return nil end

	char.Archivable = true
	local charClone = char:Clone()
	char.Archivable = false

	charClone.Name = "PlayerPointingClone"
	
	for _, desc in ipairs(charClone:GetDescendants()) do
		if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CastShadow = false
			desc.Material = Enum.Material.Neon
			desc.Color = targetColor
			desc.Transparency = 0.2
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			desc:Destroy()
		elseif desc:IsA("BillboardGui") or desc:IsA("Highlight") then
			desc:Destroy()
		end
	end

	local rightHand = charClone:FindFirstChild("RightHand") or charClone:FindFirstChild("Right Arm") or charClone:FindFirstChild("RightUpperArm")
	if rightHand then
		local cardReplica = Instance.new("Part")
		cardReplica.Name = "HeldCardReplica"
		cardReplica.Size = Vector3.new(0.8, 1.2, 0.1)
		cardReplica.Material = Enum.Material.Neon
		cardReplica.Color = targetColor
		cardReplica.Transparency = 0.1
		cardReplica.CanCollide = false
		cardReplica.CastShadow = false
		cardReplica.CFrame = rightHand.CFrame * CFrame.new(0, -0.8, 0) * CFrame.Angles(math.rad(90), 0, 0)
		cardReplica.Parent = charClone
		
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = rightHand
		weld.Part1 = cardReplica
		weld.Parent = cardReplica
	end

	local humanoid = charClone:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		local isR15 = charClone:FindFirstChild("UpperTorso") ~= nil
		local animId = isR15 and "rbxassetid://12521007694" or "rbxassetid://128853357"
		
		pcall(function()
			local animObj = Instance.new("Animation")
			animObj.AnimationId = animId
			local animationTrack = animator:LoadAnimation(animObj)
			animationTrack.Priority = Enum.AnimationPriority.Action
			animationTrack:Play()
			animationTrack.TimePosition = 0.5
			animationTrack:AdjustSpeed(0)
		end)
	end

	charClone.Parent = cardInstance
	return charClone
end

-- Gerenciamento de Feixe Conector (Beacon) e Texto "FOUNDED CARD!!" flutuando sobre as cartas (limite de 5 studs)
local function updateInterCardLinks()
	if not espEnabled then
		clearAllConnectingBeacons()
		return
	end

	local groupedCards = {}
	for cardInstance, data in pairs(activeEspConnections) do
		if cardInstance and cardInstance.Parent and cardInstance:IsDescendantOf(Workspace) and isCardVisible(cardInstance) then
			local cardType = data.CardType
			if cardType then
				groupedCards[cardType] = groupedCards[cardType] or {}
				table.insert(groupedCards[cardType], cardInstance)
			end
		end
	end

	local neededLinks = {}

	for cardType, cards in pairs(groupedCards) do
		if #cards >= 2 then
			local bestPair = nil
			local shortestDistance = math.huge

			for i = 1, #cards do
				for j = i + 1, #cards do
					local posA = getCardPosition(cards[i])
					local posB = getCardPosition(cards[j])
					if posA and posB then
						local dist = (posA - posB).Magnitude
						if dist <= MAX_LINK_DISTANCE and dist < shortestDistance then
							shortestDistance = dist
							bestPair = {cards[i], cards[j], cardType, dist}
						end
					end
				end
			end

			if bestPair then
				local cardA, cardB, cType, dist = unpack(bestPair)
				local pairKey = tostring(cardA:GetDebugId()) .. "_" .. tostring(cardB:GetDebugId())
				neededLinks[pairKey] = {CardA = cardA, CardB = cardB, Color = cardTypeColors[cType] or Color3.fromRGB(255, 255, 255), Type = cType}
			end
		end
	end

	for key, linkPart in pairs(activeBeaconsLinks) do
		if not neededLinks[key] then
			if linkPart then linkPart:Destroy() end
			activeBeaconsLinks[key] = nil
			alreadyNotifiedPairs[key] = nil
		end
	end

	for key, data in pairs(neededLinks) do
		local posA = getCardPosition(data.CardA)
		local posB = getCardPosition(data.CardB)

		if posA and posB then
			local linkPart = activeBeaconsLinks[key]
			if not linkPart or not linkPart.Parent then
				linkPart = Instance.new("Part")
				linkPart.Name = "InterCardBeaconLink"
				linkPart.Material = Enum.Material.Neon
				linkPart.Transparency = 0.3
				linkPart.Anchored = true
				linkPart.CanCollide = false
				linkPart.CastShadow = false
				linkPart.Parent = Workspace
				activeBeaconsLinks[key] = linkPart

				local foundedBillboard = Instance.new("BillboardGui")
				foundedBillboard.Name = "FoundedBillboard"
				foundedBillboard.Size = UDim2.new(0, 200, 0, 50)
				foundedBillboard.StudsOffset = Vector3.new(0, 3, 0)
				foundedBillboard.AlwaysOnTop = true
				foundedBillboard.Adornee = linkPart
				foundedBillboard.Parent = linkPart

				local foundedLabel = Instance.new("TextLabel")
				foundedLabel.Size = UDim2.new(1, 0, 1, 0)
				foundedLabel.BackgroundTransparency = 1
				foundedLabel.Text = "💥 FOUNDED CARD!! 💥"
				foundedLabel.TextColor3 = data.Color
				foundedLabel.TextScaled = true
				foundedLabel.Font = Enum.Font.SourceSansBold
				foundedLabel.Parent = foundedBillboard

				local stroke = Instance.new("UIStroke")
				stroke.Color = Color3.fromRGB(0, 0, 0)
				stroke.Thickness = 2
				stroke.Parent = foundedLabel
			end

			local distance = (posA - posB).Magnitude
			linkPart.Size = Vector3.new(0.6, 0.6, distance)
			linkPart.CFrame = CFrame.new(posA:Lerp(posB, 0.5), posB)
			linkPart.Color = data.Color
		end
	end
end

RunService.RenderStepped:Connect(function()
	if espEnabled then
		updateInterCardLinks()
	end
end)

-- Função para gerar o efeito de explosão de partículas na revelação
local function triggerCardExplosion(cardInstance, targetColor)
	local primaryPart = cardInstance:IsA("Model") and (cardInstance.PrimaryPart or cardInstance:FindFirstChildWhichIsA("BasePart")) or (cardInstance:IsA("BasePart") and cardInstance)
	if not primaryPart then return end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "CardExplosionEffect"
	emitter.Color = ColorSequence.new(targetColor)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.5)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(12, 28)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = primaryPart

	emitter:Emit(50)

	task.delay(2, function()
		if emitter and emitter.Parent then
			emitter:Destroy()
		end
	end)
end

-- Criador de ESP, Textos RGB, Aura, Beacon, Sparkles, PointLight, Clone Neon apontando e Explosão
local function createCardEsp(cardInstance, cardType)
	if not cardInstance or not espEnabled then return end

	local upperType = string.upper(tostring(cardType))
	local targetColor = cardTypeColors[upperType] or Color3.fromRGB(255, 255, 255)

	if activeEspConnections[cardInstance] then
		if activeEspConnections[cardInstance].Highlight then
			activeEspConnections[cardInstance].Highlight.FillColor = targetColor
			activeEspConnections[cardInstance].Highlight.OutlineColor = targetColor
		end
		if activeEspConnections[cardInstance].Beacon then
			activeEspConnections[cardInstance].Beacon.Color = targetColor
		end
		if activeEspConnections[cardInstance].Sparkles then
			activeEspConnections[cardInstance].Sparkles.SparkleColor = targetColor
		end
		if activeEspConnections[cardInstance].PointLight then
			activeEspConnections[cardInstance].PointLight.Color = targetColor
		end
		return
	end

	triggerCardExplosion(cardInstance, targetColor)

	local primaryPart = cardInstance:IsA("Model") and (cardInstance.PrimaryPart or cardInstance:FindFirstChildWhichIsA("BasePart")) or (cardInstance:IsA("BasePart") and cardInstance)

	local playerClone = createPlayerPointingClone(cardInstance, targetColor)

	local highlight = Instance.new("Highlight")
	highlight.Name = "CardEspHighlight"
	highlight.Adornee = cardInstance
	highlight.FillColor = targetColor
	highlight.OutlineColor = targetColor
	highlight.FillTransparency = 0.3
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = cardInstance

	local sparkles = Instance.new("Sparkles")
	sparkles.Name = "CardSparkles"
	sparkles.SparkleColor = targetColor
	if primaryPart then
		sparkles.Parent = primaryPart
	end

	local pointLight = Instance.new("PointLight")
	pointLight.Name = "CardPointLight"
	pointLight.Color = targetColor
	pointLight.Brightness = 3
	pointLight.Range = 12
	if primaryPart then
		pointLight.Parent = primaryPart
	end

	local beacon = Instance.new("Part")
	beacon.Name = "CardBeacon"
	beacon.Size = Vector3.new(3, 300, 3)
	beacon.Material = Enum.Material.Neon
	beacon.Color = targetColor
	beacon.Transparency = 0.4
	beacon.Anchored = true
	beacon.CanCollide = false
	beacon.CastShadow = false
	beacon.Parent = cardInstance

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_" .. cardInstance.Name
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = cardInstance
	billboard.Parent = espGui

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = tostring(cardType)
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 18
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.TextStrokeTransparency = 0
	textLabel.Parent = billboard

	local renderConnection = RunService.RenderStepped:Connect(function()
		if not espEnabled or not cardInstance or not cardInstance.Parent or not cardInstance:IsDescendantOf(Workspace) or not isCardVisible(cardInstance) then
			removeSingleEsp(cardInstance)
			return
		end

		local cardPos = getCardPosition(cardInstance)
		if cardPos then
			beacon.CFrame = CFrame.new(cardPos + Vector3.new(0, 150, 0))
			if playerClone then
				playerClone:PivotTo(CFrame.new(cardPos + Vector3.new(0, 2.5, 0)))
			end
		end

		local hue = (tick() * 2) % 1
		textLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
	end)

	local ancestryConnection = cardInstance.AncestryChanged:Connect(function()
		if not cardInstance:IsDescendantOf(Workspace) then
			removeSingleEsp(cardInstance)
		end
	end)

	activeEspConnections[cardInstance] = {
		CardType = upperType,
		Billboard = billboard,
		Highlight = highlight,
		Beacon = beacon,
		Sparkles = sparkles,
		PointLight = pointLight,
		PlayerClone = playerClone,
		RenderConnection = renderConnection,
		AncestryConnection = ancestryConnection
	}
end

-- Monitoramento exclusivo do Evento CardRevealed
task.spawn(function()
	local memoryKill = ReplicatedStorage:WaitForChild("MemoryKill", 5)
	if memoryKill then
		local remotes = memoryKill:WaitForChild("Remotes", 5)
		if remotes then
			local cardRevealed = remotes:WaitForChild("CardRevealed", 5)
			if cardRevealed then
				cardRevealed.OnClientEvent:Connect(function(cardId, cardType)
					if not espEnabled then return end

					local targetCard = findExactCard(cardId)
					if targetCard then
						createCardEsp(targetCard, cardType)
					end
				end)
			end
		end
	end
end)
