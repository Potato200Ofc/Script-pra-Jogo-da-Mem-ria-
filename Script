-- Função para detectar a carta que o jogador está pisando
local function getCardFromPath()
	local cardsFolder = getPlayerCardsFolder()
	if not cardsFolder then return nil end

	local character = player.Character or player.CharacterAdded:Wait()
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {character}

	local raycastResult = Workspace:Raycast(rootPart.Position, Vector3.new(0, -25, 0), raycastParams)
	if raycastResult and raycastResult.Instance then
		local hitPart = raycastResult.Instance
		local current = hitPart
		while current and current ~= Workspace do
			if current.Parent == cardsFolder then
				return current
			end
			current = current.Parent
		end
	end
	
	return nil
end

local function fireRemote()
	pcall(function()
		local memoryKill = ReplicatedStorage:WaitForChild("MemoryKill", 2)
		if memoryKill then
			local remotes = memoryKill:WaitForChild("Remotes", 2)
			if remotes then
				local cardJumpRequest = remotes:WaitForChild("CardJumpRequest", 2)
				if cardJumpRequest then
					cardJumpRequest:FireServer()
				end
			end
		end
	end)
end

-- Aplicando vidro translúcido e deslocamento exato de 0.1 studs acima da carta original
local function applyGlassAndPosition(clone)
	if clone:IsA("Model") then
		for _, descendant in ipairs(clone:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.Material = Enum.Material.Glass
				descendant.Transparency = 0.3
			end
		end
		local currentPivot = clone:GetPivot()
		clone:PivotTo(currentPivot + Vector3.new(0, 0.1, 0))
	elseif clone:IsA("BasePart") then
		clone.Material = Enum.Material.Glass
		clone.Transparency = 0.3
		clone.Position = clone.Position + Vector3.new(0, 0.1, 0)
	end
end

-- Função auxiliar para checar se a carta está visível
local function isCardVisible(cardInstance)
	if cardInstance:IsA("BasePart") then
		return cardInstance.Transparency < 1
	elseif cardInstance:IsA("Model") then
		for _, desc in ipairs(cardInstance:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Transparency < 1 then
				return true
			end
		end
		return false
	end
	return true
end

