-- Identifica a pasta da mesa/arena onde o jogador está no momento
local function getPlayerCardsFolder()
	local matchOff = Workspace:FindFirstChild("MatchOff_Arena")
	if not matchOff then return nil end
	
	local cardsFolder = matchOff:FindFirstChild("Cards")
	if cardsFolder then
		return cardsFolder
	end
	return nil
end

-- Posição segura do centro da carta
local function getCardPosition(cardInstance)
	if not cardInstance or not cardInstance.Parent then return nil end
	if cardInstance:IsA("Model") then
		return cardInstance:GetPivot().Position
	elseif cardInstance:IsA("BasePart") then
		return cardInstance.Position
	end
	return nil
end

-- Declaração antecipada
local removeSingleEsp

-- Função para limpar todos os feixes conectores entre pares
local function clearAllConnectingBeacons()
	for key, linkPart in pairs(activeBeaconsLinks) do
		if linkPart then linkPart:Destroy() end
	end
	activeBeaconsLinks = {}
	alreadyNotifiedPairs = {}
end

-- Função para limpar todos os ESPs, Billboards, Auras, Beacons, Sparkles e Luzes
local function clearAllEspAndAuras()
	for card, _ in pairs(activeEspConnections) do
		removeSingleEsp(card)
	end
	activeEspConnections = {}
	clearAllConnectingBeacons()
	espGui:ClearAllChildren()

	local cardsFolder = getPlayerCardsFolder()
	if cardsFolder then
		for _, card in ipairs(cardsFolder:GetChildren()) do
			local hl = card:FindFirstChild("CardEspHighlight")
			if hl then hl:Destroy() end
			local beacon = card:FindFirstChild("CardBeacon")
			if beacon then beacon:Destroy() end
			local playerClone = card:FindFirstChild("PlayerPointingClone")
			if playerClone then playerClone:Destroy() end
			local primaryPart = card:IsA("Model") and (card.PrimaryPart or card:FindFirstChildWhichIsA("BasePart")) or (card:IsA("BasePart") and card)
			if primaryPart then
				local sp = primaryPart:FindFirstChild("CardSparkles")
				if sp then sp:Destroy() end
				local light = primaryPart:FindFirstChild("CardPointLight")
				if light then light:Destroy() end
			end
		end
	end
end

removeSingleEsp = function(cardInstance)
	if activeEspConnections[cardInstance] then
		local data = activeEspConnections[cardInstance]
		if data.RenderConnection then data.RenderConnection:Disconnect() end
		if data.AncestryConnection then data.AncestryConnection:Disconnect() end
		if data.Billboard then data.Billboard:Destroy() end
		if data.Highlight then data.Highlight:Destroy() end
		if data.Beacon then data.Beacon:Destroy() end
		if data.Sparkles then data.Sparkles:Destroy() end
		if data.PointLight then data.PointLight:Destroy() end
		if data.PlayerClone then data.PlayerClone:Destroy() end
		activeEspConnections[cardInstance] = nil
	end
end

